<?xml version="1.0" encoding="utf-8" ?>
<configuration>
	<startup> 
		<supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
	</startup>
	<appSettings>
		<!-- EMQX ダッシュボード URL（デフォルト: http://localhost:18083/） -->
		<add key="ProbeUrl" value="http://localhost:18083/" />
		<add key="TimeoutSeconds" value="5" />
		<add key="IntervalSeconds" value="60" />
		<add key="FailThreshold" value="3" />

		<!-- EMQX 実行設定 -->
		<!-- emqx start (デーモン): EmqxUseVisibleWindow=false でバックグラウンド起動 -->
		<!-- emqx console (対話): EmqxUseVisibleWindow=true でコンソールウィンドウを開く（TTY が必要） -->
		<!-- WSL 経由で emqx console を使う例:
		     EmqxExePath="wsl"
		     EmqxArgs="bash -c &quot;cd /mnt/c/Users/Kosuke-Takahashi/Desktop &amp;&amp; ./emqx console&quot;"
		     EmqxUseVisibleWindow="true" -->
		<!-- Git Bash 経由の例:
		     EmqxExePath="C:\Program Files\Git\bin\bash.exe"
		     EmqxArgs="-c &quot;cd /c/Users/Kosuke-Takahashi/Desktop &amp;&amp; ./emqx console&quot;"
		     EmqxStopArgs="-c &quot;cd /c/Users/Kosuke-Takahashi/Desktop &amp;&amp; ./emqx stop&quot;"
		     EmqxUseVisibleWindow="true" -->
		<!-- EmqxStopArgs: WSL 等でプロセスが見えない場合、emqx stop コマンドで停止 -->
		<!-- EmqxRunningCheck: "process"=プロセス名で判定 / "probe"=HTTP疎通で判定（WSL推奨） -->
		<add key="EmqxExePath" value="C:\Program Files (x86)\emqx\bin\emqx.cmd" />
		<add key="EmqxArgs" value="console" />
		<add key="EmqxStopArgs" value="stop" />
		<add key="EmqxProcessName" value="beam" />
		<add key="EmqxRunningCheck" value="process" />
		<add key="EmqxRestartDelaySeconds" value="2" />
		<add key="EmqxUseVisibleWindow" value="true" />
		<add key="EmqxWorkingDirectory" value="C:\Program Files (x86)\emqx\bin" />

		<!-- 監視用の疎通チェックでプロキシを使うかどうか（true: プロキシ使用, false: プロキシなし） -->
		<add key="UseProxyForProbe" value="false" />

		<!-- 疎通チェックに使うプロキシアドレス（例: http://localhost:8080）-->
		<add key="ProbeProxyAddress" value="http://localhost:8080" />
	</appSettings>
</configuration>
